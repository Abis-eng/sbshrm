{
  "manifest_version": 3,
  "name": "HRM Screen Capture",
  "version": "1.0.0",
  "description": "Automatic screen capture for HRM system - captures entire screen when employee checks in",
  "permissions": [
    "desktopCapture",
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}

